{
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": [
    "pulseaudio",
    "battery",
    "network",
    "cpu",
    "memory",
    "tray",
    "custom/power",
  ],

  "hyprland/workspaces": {
    "format": "{icon}"
  },
  
  "clock": {
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "{:%d/%m/%Y - %H:%M:%S}",
    "interval": 1
  },

  "network": {
    "format-wifi": "{bandwidthDownBits}",
    "format-ethernet": "{bandwidthDownBits}",
    "interval": 5,
    "tooltip": false
  },

  "cpu": {
    "interval": 1,
  },

  "memory": {
    "interval": 15,
    "format": "{used:0.1f}G/{total:0.1f}G"
  },

  "pulseaudio": {
    "format": "speaker {volume}%",
  },

  "custom/power": {
    "tooltip": false,
    "on-click": "wlogout &",
    "format": "⏻"
  },
}
